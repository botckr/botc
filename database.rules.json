{
  "rules": {
    "admin_auth": {
      "$password": {
        ".read": "auth != null"
      }
    },
    "history": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },
    "public": {
      "rooms": {
        "$roomId": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('stUid').val() === auth.uid)",
          "players": {
            "$uid": {
              ".write": "auth != null && $uid === auth.uid"
            }
          },
          "nominations": {
            "$nomId": {
              "voters": {
                "$uid": {
                  ".write": "auth != null && $uid === auth.uid"
                }
              }
            }
          },
          "events": {
            "$eventId": {
              ".write": "auth != null"
            }
          }
        }
      }
    },
    "secret": {
      "rooms": {
        "$roomId": {
          ".read": "auth != null && (!data.exists() || data.child('stUid').val() === auth.uid || data.child('players').child(auth.uid).child('character').val() === 'spy')",
          ".write": "auth != null && (!data.exists() || data.child('stUid').val() === auth.uid)",
          
          "players": {
            "$uid": {
              ".read": "auth != null && $uid === auth.uid",
              ".write": "auth != null && root.child('secret/rooms/' + $roomId + '/stUid').val() === auth.uid"
            }
          },
          "nightActions": {
            "$uid": {
              ".write": "auth != null && $uid === auth.uid"
            }
          }
        }
      }
    }
  }
}